# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.

# Claude API key. With 9router or another Anthropic-compatible gateway, use that gateway's key.
ANTHROPIC_API_KEY=

# Leave empty for the official Anthropic API.
# For 9router or another Anthropic-compatible gateway, set its base URL, for example:
# ANTHROPIC_BASE_URL=https://your-9router-host/v1
ANTHROPIC_BASE_URL=

# Model that plans the captions. Use a model id your provider or 9router combo exposes.
ANTHROPIC_MODEL=claude-haiku-5-5

# Whisper model for transcription: tiny, base, small, medium, large-v3, large-v3-turbo.
WHISPER_MODEL=large-v3-turbo

# Optional: Hugging Face token for faster Whisper model downloads.
HF_TOKEN=

# Caption colors as #RRGGBB. Box opacity is 0 (invisible) to 1 (solid).
CAPTION_BOX_COLOR=#4D5B4A
CAPTION_BOX_OPACITY=0.95
CAPTION_UPCOMING_COLOR=#A8B0A5
CAPTION_ACTIVE_COLOR=#F9D054
CAPTION_SPOKEN_COLOR=#FAFAFA
CAPTION_KEYWORD_COLOR=#F9D054
